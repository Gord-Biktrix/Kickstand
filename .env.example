# Copy to .env.local for development. Never commit real secrets.
DATABASE_URL=postgres://localhost:5432/pickup_dev
AUTH_SECRET=change-me-32-random-bytes
AUTH_EMAIL_FROM=pickups@biktrix.com
AUTH_ALLOWED_DOMAIN=biktrix.com
AUTH_ALLOWED_EMAILS=gord@biktrix.com
# Development only: render the magic link on the login page instead of emailing it.
AUTH_DEV_SHOW_LINK=true
# Optional: Resend API key for real magic-link email. Console logging is used when empty.
RESEND_API_KEY=
KLAVIYO_PRIVATE_KEY=
KLAVIYO_REVISION=2025-07-15
CRON_SECRET=change-me
APP_BASE_URL=http://localhost:3000
DEFAULT_SHOWROOM=vancouver

# Lightspeed R-Series bridge (README "Lightspeed bridge"). Tokens live in the database; run scripts/ls-setup.ts once.
LS_CLIENT_ID=
LS_CLIENT_SECRET=
